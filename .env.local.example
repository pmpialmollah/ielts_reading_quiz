# Example env file for local development (do NOT commit real secrets)
# Copy this file to `.env.local` and fill in values, or add secrets via your
# deployment provider (preferred) and use the Settings page for local testing.

# Your Gemini API key (optional — leave unset to use demo sample quiz)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
